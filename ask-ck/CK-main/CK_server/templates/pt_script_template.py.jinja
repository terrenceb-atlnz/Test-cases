        # handles None and `self.cusfp_supported` False; the cases that need it check the
        # flag and report UNSUPPORTED instead of failing. Far port: `cusfp_peer.portCuSfp`.
        ({{ dut }}.portCuSfp, cusfp_port, cusfp_peer) = self._ck_bind_link(
            setup, {{ dut }}, 'cusfp', optional=True)
        self.cusfp_supported = cusfp_peer is not None
        if self.cusfp_supported:
            cusfp_peer.portCuSfp = cusfp_port
        self.cusfp_peer = cusfp_peer
        {%- endif %}
        {%- if links.fibre %}
        # The FIBRE link (a fitted fibre module), OPTIONAL in the same shape; the flag is
        # `self.fibre_supported`, the far port `fibre_peer.portFibre`. Role-specific far names
        # on purpose: two pluggable links often land on the SAME partner switch, and a shared
        # `.portDut` there would be overwritten by the next binding.
        ({{ dut }}.portFibre, fibre_port, fibre_peer) = self._ck_bind_link(
            setup, {{ dut }}, 'fibre', optional=True)
        self.fibre_supported = fibre_peer is not None
        if self.fibre_supported:
            fibre_peer.portFibre = fibre_port
        self.fibre_peer = fibre_peer
        {%- endif %}
        {%- if links.copper %}
