{#-
  PyTest Creator — standardized ART test-script SKELETON.

  This is NOT a prompt. It renders a complete, runnable, conformant Allied Telesis
  `framework` (ATTestSet/ATTestCase) script from a reviewed sequence. The LLM fills
  the FREE SLOTS only (marked  # >>> FILL ... <<<  ); the frame — header, TestSet
  structure, per-step TestCase classes, the logging contract inside each main(), and
  the __main__ footer — is fixed so output is standardized and mechanically checkable.

  Three slot kinds (never conflated — see LOGGING-CONTRACT.md + PLAN §1.4):
    1. TestSet.configure()/tear_down()  = suite setup/cleanup, config commands, NO pass/fail
    2. TestCase_<n>.main()              = ONE verification step; logging contract APPLIES
    3. framework automatics             = nothing here (subclassing gets them free)

  Context expected:
    case_key       e.g. "AWPTCM-T33234"
    case_title     one-line title
    extra_imports  list of extra `from framework...`/module import lines (may be empty)
    setup_steps    list of {action} suite-setup actions -> TestSet.configure() (may be empty)
    steps          list of {n, action, verify} verification steps -> TestCase_<n>
    switches       list of switch names to bind (e.g. ["swi_a","swi_b"]) — default ["swi_a"]
    stacks         list of stack names to bind (e.g. ["stk_a"]) — may be empty
    needs_portlink truthy if the case uses port links (renders an init_portlink FILL slot)
-#}
{%- set switches = switches or ['swi_a'] -%}
{%- set all_devs = switches + (stacks or []) -%}
{%- set has_physical = steps | selectattr('kind', 'equalto', 'physical') | list | length > 0 -%}
{%- set has_manual = steps | selectattr('kind', 'equalto', 'manual') | list | length > 0 -%}
#!/usr/bin/python3
# Generated by Ask CK PyTest Creator for {{ case_key }} — {{ case_title }}
# Standardized ART framework script. Frame is fixed; test logic is filled per step.

import sys
import time
{%- if has_manual %}
from distutils.util import strtobool
{%- endif %}
from framework import ATTestSet, ATTestCase
{%- for imp in extra_imports %}
{{ imp }}
{%- endfor %}

{% if has_manual %}
def yesNo(question):
    # Operator Y/N confirmation for MANUAL steps (SVT 3009 pattern).
    sys.stdout.write('%s [y/n]\n' % question)
    while True:
        try:
            return strtobool(input().lower())
        except ValueError:
            sys.stdout.write("Please respond with 'y' or 'n'.\n")

{% endif %}
class TestSet(ATTestSet.TestSet):

    FEATURES = ['ALL']

    def init(self, setup):
        # Bind the topology declared in the .setup file. Every device a TestCase
        # references must be bound here, and these names MUST match the [switch]/[stack]
        # sections of the .setup file used at Run (they are NOT a fixed convention —
        # the names below are taken from the reused fragments / sequence and may need
        # renaming to your .setup's device names).
        tb = setup.init_tb()
        {%- for dev in switches %}
        {{ dev }} = setup.init_swi('{{ dev }}')
        {%- endfor %}
        {%- for st in (stacks or []) %}
        {{ st }} = setup.init_stk('{{ st }}')
        {%- endfor %}
        {%- if needs_portlink %}
        # >>> FILL: declare the port link(s) this case needs, e.g.
        #     ({{ all_devs[0] }}.portA, tb.ethA) = setup.init_portlink({{ all_devs[0] }}, tb, type1='port') <<<
        {%- endif %}
        self.tb = tb
        {%- for dev in all_devs %}
        self.{{ dev }} = {{ dev }}
        {%- endfor %}

    def configure(self):
        # One-time SUITE setup, runs ONCE before all test cases. Base config only
        # (interfaces / vlans / ip / etc.). NO self.passed()/self.failed() here —
        # this is setup, not a test step.
        {%- if setup_steps %}
        {%- for s in setup_steps %}
        # setup: {{ s.action }}
        # >>> FILL: configuration commands for the above (e.g. self.{{ (devices or ['swi_a'])[0] }}.mode(')#'); self.{{ (devices or ['swi_a'])[0] }}.cmd('...')) <<<
        {%- endfor %}
        pass  # >>> remove once the setup commands above are filled in <<<
        {%- else %}
        pass  # no suite-level setup required for this case
        {%- endif %}

    def tear_down(self):
        # One-time SUITE cleanup, runs ONCE after all cases. Restore device state.
        # NO pass/fail here.
        # >>> FILL: teardown commands that undo configure() (or `pass` if none) <<<
        pass

{% for step in steps %}
class TestCase_{{ step.n }}(ATTestCase.TestCase):
    testCaseDesc = {{ (step.action | default('') ) | tojson }}
    testCaseRef = '{{ case_key }}'
    testCaseMethod = {{ ((step.action | default('')) ~ ' | verify: ' ~ (step.verify | default(''))) | tojson }}

    def main(self):
        # STEP {{ step.n }} — logging contract (mandatory, do not remove the three calls):
        self.log('STEP {{ step.n }}: {{ (step.action | default('')) | replace("'", "") }}')
{%- if step.kind == 'physical' %}
        # PHYSICAL step: a human must act on the hardware, then the script waits for the
        # resulting port state change and continues (SVT 3009 waitForReplugEvent pattern).
        dut = self.testSet.{{ (switches or ['dut'])[0] }}
        port = 'portX.Y.Z'  # >>> FILL: the target port (must exist in the .setup) <<<
        self.log('OPERATOR: {{ (step.action | default('perform the physical action')) | replace("'", "") }}')
        # Poll show-interface status for the expected transition, prompting the operator.
        # >>> FILL: set the state to wait for — 'connected' after insert, 'notconnect' after removal <<<
        want = 'connected'
        deadline = time.time() + 120  # >>> adjust operator timeout (s) <<<
        output = ''
        while time.time() < deadline:
            output = dut.cmd('show interface {} status'.format(port), log=False)
            if want in output:
                break
            self.log('Waiting for operator: {{ (step.action | default('')) | replace("'", "") }}')
            time.sleep(2)
        self.log('OBSERVED: {}'.format(output))
        # >>> FILL: confirm the state change against: {{ (step.verify | default('')) | replace("'", "") }} <<<
        if want in output:  # >>> replace with the real verification condition <<<
            self.passed('{{ (step.verify | default('expected state change observed')) | replace("'", "") }}')
        else:
            self.failed('{{ (step.verify | default('operator action / state change not observed within timeout')) | replace("'", "") }}')
{%- elif step.kind == 'manual' %}
        # MANUAL step: a visual/physical check the DEVICE cannot self-report (LED, seating).
        # Prompt the operator for a Y/N confirmation (SVT 3009 yesNo pattern).
        self.log('OPERATOR CHECK: {{ (step.verify | default('confirm the manual check')) | replace("'", "") }}')
        # >>> FILL: phrase the exact yes/no question the operator answers <<<
        ok = yesNo('{{ (step.verify | default('Did the check pass')) | replace("'", "") }} - press Y/N')
        self.log('OBSERVED: operator answered {}'.format('Y' if ok else 'N'))
        if ok:
            self.passed('{{ (step.verify | default('operator confirmed')) | replace("'", "") }}')
        else:
            self.failed('{{ (step.verify | default('operator did not confirm')) | replace("'", "") }}')
{%- else %}
        # >>> FILL: perform the action on the device(s) via self.testSet.<dev>.mode()/.cmd(),
        #     traffic via scapy/tcpdump, etc. Capture the observed output into `output`. <<<
        output = ''  # >>> replace with the real observation this step verifies <<<
        self.log('OBSERVED: {}'.format(output))
        # >>> FILL: decide pass/fail from `output` against: {{ (step.verify | default('')) | replace("'", "") }}
        #     End with EXACTLY ONE non-empty assertion. Empty passed()/failed() emit no marker. <<<
        if False:  # >>> replace with the real verification condition <<<
            self.passed('{{ (step.verify | default('verification met')) | replace("'", "") }}')
        else:
            self.failed('{{ (step.verify | default('verification not met')) | replace("'", "") }}')
{%- endif %}

    def tear_down(self):
        # Per-case cleanup: undo anything THIS step changed on the device(s) so the
        # next case starts clean. Runs after main(). NO pass/fail here. Leave as
        # `pass` if this step needs no per-case cleanup.
        # >>> FILL (optional): commands to revert this step's changes <<<
        pass

{% endfor %}
if __name__ == '__main__':
    ts = TestSet()
    {%- for step in steps %}
    ts.add_testCase(TestCase_{{ step.n }}())
    {%- endfor %}
    ts.run(sys.argv)
