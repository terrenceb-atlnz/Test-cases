{% for step in steps %}
class TestCase_{{ step.n }}(ATTestCase.TestCase):
    testCaseDesc = {{ (step.action | default('', true) ) | pyliteral }}
    testCaseRef = '{{ case_key }}'
    testCaseMethod = {{ ((step.action | default('', true)) ~ ' | verify: ' ~ (step.verify | default('', true))) | pyliteral }}

    def main(self):
        self.log({{ ('STEP ' ~ step.n ~ ': ' ~ (step.action | default('', true))) | pyliteral }})
{%- if step.kind == 'physical' %}
        # PHYSICAL: the operator acts on the hardware, then we poll for the state change.
        dut = self.testSet.{{ dev0 }}
        port = dut.portA  # >>> FILL: the init_portlink() attribute for this link <<<
        self.log({{ ('OPERATOR: ' ~ (step.action | default('perform the physical action', true))) | pyliteral }})
        want = 'connected'  # >>> FILL: 'connected' after insert, 'notconnect' after removal <<<
        deadline = time.time() + 120  # >>> adjust operator timeout (s) <<<
        output = ''
        while time.time() < deadline:
            # Scoped to ONE port, so a plain substring test here is safe.
            output = dut.cmd('show interface {} status'.format(port.name), log=False)
            if want in output:
                break
            self.log({{ ('Waiting for operator: ' ~ (step.action | default('', true))) | pyliteral }})
            time.sleep(2)
        self.log('OBSERVED: {}'.format(output))
        if want in output:  # >>> replace with the real verification condition <<<
            self.passed({{ (step.verify | default('expected state change observed', true)) | pyliteral }})
        else:
            self.failed({{ (step.verify | default('operator action / state change not observed within timeout', true)) | pyliteral }})
{%- elif step.kind == 'manual' %}
        # MANUAL: a check the device cannot self-report (LED, physical seating).
        self.log({{ ('OPERATOR CHECK: ' ~ (step.verify | default('confirm the manual check', true))) | pyliteral }})
        ok = yesNo({{ ((step.verify | default('Did the check pass', true)) ~ ' - press Y/N') | pyliteral }})  # >>> FILL: phrase the question <<<
        self.log('OBSERVED: operator answered {}'.format('Y' if ok else 'N'))
        if ok:
            self.passed({{ (step.verify | default('operator confirmed', true)) | pyliteral }})
        else:
            self.failed({{ (step.verify | default('operator did not confirm', true)) | pyliteral }})
{%- else %}
        output = ''  # >>> FILL: the real observation (see rule 1) <<<
        self.log('OBSERVED: {}'.format(output))
        # >>> FILL: verify — {{ (step.verify | default('', true)) | replace('\n', ' ') }} <<<
        if False:  # >>> replace with the real condition <<<
            self.passed({{ (step.verify | default('verification met', true)) | pyliteral }})
        else:
            self.failed({{ (step.verify | default('verification not met', true)) | pyliteral }})
{%- endif %}

    def tear_down(self):
        # Per-case cleanup so the next case starts clean. No pass/fail.
        # >>> FILL (optional): commands reverting this step, or leave `pass` <<<
        pass

