{%- if has_pluggable %}
def assert_role_media_now(testCase, dut, port, role):
    """Assert the media of a PLUGGABLE role NOW — after the operator has (re)fitted the module.

    Module-level on purpose: the frame's lint reads every `self.testSet.<name>` as a device
    handle that init() must bind. Records the verdict on `testCase` and returns True/False,
    because by this point a wrong module is a test-relevant observation the operator can
    correct — unlike at init(), where a missing link is a bench problem.
    """
    import ck_media
    status = dut.cmd('show interface %s status' % port.name)
    ok, why = ck_media.assert_role_media(status, port.name, role)
    if ok:
        testCase.passed('module on %s matches the %r role: %s' % (port.name, role, why))
    else:
        testCase.failed('module on %s does NOT match the %r role: %s' % (port.name, role, why))
    return ok


