{#-
  PyTest Creator — standardized ART test-script SKELETON.

  This is NOT a prompt. It renders a complete, runnable, conformant Allied Telesis
  `framework` (ATTestSet/ATTestCase) script from a reviewed sequence. The LLM fills
  the FREE SLOTS only (marked  # >>> FILL ... <<<  ); the frame — header, TestSet
  structure, per-step TestCase classes, the logging contract inside each main(), and
  the __main__ footer — is fixed so output is standardized and mechanically checkable.

  Three slot kinds (never conflated — see LOGGING-CONTRACT.md + PLAN §1.4):
    1. TestSet.configure()/tear_down()  = suite setup/cleanup, config commands, NO pass/fail
    2. TestCase_<n>.main()              = ONE verification step; logging contract APPLIES
    3. framework automatics             = nothing here (subclassing gets them free)

  RULE FOR EDITORS (learned the hard way, 2026-07-28): a comment in this file ships into
  every generated script, and where prose and EXAMPLE disagree the model copies the
  EXAMPLE. Four separate defects in generated scripts came from wrong examples here or in
  the prompt (`port = 'port1.0.1'`, `split()[-2:] == [...]`, `self.dut.portA` in init).
  So: guidance for the MODEL belongs in pt_generate_script.jinja rules; this file carries
  only what a reader of the finished test needs, and every example here must be correct
  against the real corpus. `tests/test_prompt_examples.py` enforces that.

  Idioms below are grounded in the 830-script corpus (counts as of 2026-07-28):
    mode(')#') = config mode 4812 | mode('#') = priv exec 4253 | mode(']#') = stack 382
    cmd('conf t') is NOT the idiom (54)   |   port.name for CLI text 1013 (vs 241 bare)
    FEATURES=['ALL'] 291/306   |   init_swi('swi_a') 621/~650   |   init_stk('stk_a') 191/191

  Context expected:
    case_key       e.g. "AWPTCM-T33234"
    case_title     one-line title
    extra_imports  list of extra `from framework...`/module import lines (may be empty)
    setup_steps    list of {action} suite-setup actions -> TestSet.configure() (may be empty)
    steps          list of {n, action, verify, kind} verification steps -> TestCase_<n>
    switches       list of switch VARIABLE names to bind (e.g. ["dut","lp"]) — default ["swi_a"]
    setup_keys     the .setup [switch] KEYS those variables look up, positionally
                   (swi_a/swi_b/...); see _setup_keys_for(). Falls back to the variable name.
    stacks         list of stack names to bind (e.g. ["stk_a"]) — may be empty
    needs_portlink truthy if the case uses port links (renders an init_portlink FILL slot)
-#}
{%- set switches = switches or ['swi_a'] -%}
{%- set all_devs = switches + (stacks or []) -%}
{%- set dev0 = all_devs[0] -%}
{%- set dev1 = all_devs[1] if all_devs | length > 1 else 'swi_b' -%}
{%- set has_physical = steps | selectattr('kind', 'equalto', 'physical') | list | length > 0 -%}
{%- set has_manual = steps | selectattr('kind', 'equalto', 'manual') | list | length > 0 -%}
#!/usr/bin/python3
# Generated by Ask CK PyTest Creator for {{ case_key }} — {{ case_title }}
# Standardized ART framework script. Frame is fixed; test logic is filled per step.

import sys
import time
from framework import ATTestSet, ATTestCase
{%- for imp in extra_imports %}
{{ imp }}
{%- endfor %}

{% if has_manual %}
def yesNo(question):
    # Operator Y/N confirmation for MANUAL steps (SVT 3009 pattern).
    # Hand-rolled rather than distutils.strtobool: that was removed in Python 3.12.
    sys.stdout.write('%s [y/n]\n' % question)
    while True:
        answer = input().strip().lower()
        if answer in ('y', 'yes'):
            return True
        if answer in ('n', 'no'):
            return False
        sys.stdout.write("Please respond with 'y' or 'n'.\n")

{% endif %}
class TestSet(ATTestSet.TestSet):

    FEATURES = ['ALL']

    def init(self, setup):
        # Topology comes from the .setup file, so this script is platform-independent:
        # the [portlink] entries resolve to real port names at runtime.
        tb = setup.init_tb()
        {%- for dev in switches %}
        {{ dev }} = setup.init_swi('{{ setup_keys[loop.index0] if setup_keys and loop.index0 < setup_keys | length else dev }}')
        {%- endfor %}
        {%- for st in (stacks or []) %}
        {{ st }} = setup.init_stk('stk_{{ 'abcdefgh'[loop.index0] }}')
        {%- endfor %}
        {%- if needs_portlink %}
        # >>> FILL: declare this case's port link(s), using the LOCAL names above (not self.):
        #     ({{ dev0 }}.portA, tb.ethA) = setup.init_portlink({{ dev0 }}, tb, type1='port')
        #     ({{ dev0 }}.portB, {{ dev1 }}.portA) = setup.init_portlink({{ dev0 }}, {{ dev1 }}, type1='port', type2='port') <<<
        {%- endif %}
        self.tb = tb
        {%- for dev in all_devs %}
        self.{{ dev }} = {{ dev }}
        {%- endfor %}

    def configure(self):
        # One-time SUITE setup, runs ONCE before all test cases. Config only — no pass/fail.
        {%- if setup_steps %}
        {%- for s in setup_steps %}
        # setup: {{ s.action }}
        {%- endfor %}
        # >>> FILL: the configuration commands for the setup step(s) above, e.g.
        #     self.{{ dev0 }}.mode(')#'); self.{{ dev0 }}.cmd('interface {}'.format(self.{{ dev0 }}.portA.name)) <<<
        pass  # >>> remove once the setup commands are filled in <<<
        {%- else %}
        pass  # no suite-level setup required for this case
        {%- endif %}

    def tear_down(self):
        # One-time SUITE cleanup, runs ONCE after all cases. No pass/fail.
        # >>> FILL: commands undoing configure(), or leave `pass` <<<
        pass

{% for step in steps %}
class TestCase_{{ step.n }}(ATTestCase.TestCase):
    testCaseDesc = {{ (step.action | default('') ) | pyliteral }}
    testCaseRef = '{{ case_key }}'
    testCaseMethod = {{ ((step.action | default('')) ~ ' | verify: ' ~ (step.verify | default(''))) | pyliteral }}

    def main(self):
        self.log({{ ('STEP ' ~ step.n ~ ': ' ~ (step.action | default(''))) | pyliteral }})
{%- if step.kind == 'physical' %}
        # PHYSICAL: the operator acts on the hardware, then we poll for the state change.
        dut = self.testSet.{{ dev0 }}
        port = dut.portA  # >>> FILL: the init_portlink() attribute for this link <<<
        self.log({{ ('OPERATOR: ' ~ (step.action | default('perform the physical action'))) | pyliteral }})
        want = 'connected'  # >>> FILL: 'connected' after insert, 'notconnect' after removal <<<
        deadline = time.time() + 120  # >>> adjust operator timeout (s) <<<
        output = ''
        while time.time() < deadline:
            # Scoped to ONE port, so a plain substring test here is safe.
            output = dut.cmd('show interface {} status'.format(port.name), log=False)
            if want in output:
                break
            self.log({{ ('Waiting for operator: ' ~ (step.action | default(''))) | pyliteral }})
            time.sleep(2)
        self.log('OBSERVED: {}'.format(output))
        if want in output:  # >>> replace with the real verification condition <<<
            self.passed({{ (step.verify | default('expected state change observed')) | pyliteral }})
        else:
            self.failed({{ (step.verify | default('operator action / state change not observed within timeout')) | pyliteral }})
{%- elif step.kind == 'manual' %}
        # MANUAL: a check the device cannot self-report (LED, physical seating).
        self.log({{ ('OPERATOR CHECK: ' ~ (step.verify | default('confirm the manual check'))) | pyliteral }})
        ok = yesNo({{ ((step.verify | default('Did the check pass')) ~ ' - press Y/N') | pyliteral }})  # >>> FILL: phrase the question <<<
        self.log('OBSERVED: operator answered {}'.format('Y' if ok else 'N'))
        if ok:
            self.passed({{ (step.verify | default('operator confirmed')) | pyliteral }})
        else:
            self.failed({{ (step.verify | default('operator did not confirm')) | pyliteral }})
{%- else %}
        output = ''  # >>> FILL: the real observation (see rule 1) <<<
        self.log('OBSERVED: {}'.format(output))
        # >>> FILL: verify — {{ (step.verify | default('')) | replace('\n', ' ') }} <<<
        if False:  # >>> replace with the real condition <<<
            self.passed({{ (step.verify | default('verification met')) | pyliteral }})
        else:
            self.failed({{ (step.verify | default('verification not met')) | pyliteral }})
{%- endif %}

    def tear_down(self):
        # Per-case cleanup so the next case starts clean. No pass/fail.
        # >>> FILL (optional): commands reverting this step, or leave `pass` <<<
        pass

{% endfor %}
if __name__ == '__main__':
    ts = TestSet()
    {%- for step in steps %}
    ts.add_testCase(TestCase_{{ step.n }}())
    {%- endfor %}
    ts.run(sys.argv)
