    def init(self, setup):
        # Topology is DISCOVERED through the framework at run time, never declared to this
        # script: the DUT is the framework's `swi_a` slot (its stack, when it is in one), the
        # partners are whatever the bench's [portlink]s cable to it, and which link is copper
        # / fibre / copper-SFP is read from the DUT itself. So the script names no port and no
        # partner, binds correctly on any bench cabled for it, and fails loudly on one that is
        # not. (`swi_a`/`stk_a`: 297/192 corpus lookups; a role-named key appears 0 times.)
        tb = setup.init_tb()
        {{ dut }} = setup.init_swi('swi_a')
        _stk = {{ dut }}.get_stack()
        if _stk is not None:
            # Ports belong to MEMBERS and [portlink] declares them per member; commands go to
            # the master. The stack handle walks its members for both.
            {{ dut }} = setup.init_stk(_stk.name)
        {%- for st in (stacks or []) %}
        {# Stack names are DETECTED as `stk_[a-z]`, so the name is already a valid .setup key
           (2026-07-28). The DUT's own stack is reused, never initialised twice. #}
        {{ st }} = {{ dut }} if (_stk is not None and _stk.name == '{{ st }}') else setup.init_stk('{{ st }}')
        {%- endfor %}
        self.tb = tb
        self.{{ dut }} = {{ dut }}
        {%- for st in (stacks or []) %}
        self.{{ st }} = {{ st }}
        {%- endfor %}
        {%- if any_link %}
        self._ck_far = {}
        self._ck_topo = self._ck_discover({{ dut }})
        {%- endif %}
        {%- if links.tb %}
        # The TESTBOX data link: the ART shape `(dut.portA, tb.ethA)`. Captures, injected
        # frames and pings happen on `tb.ethA`; `{{ dut }}.portA` is the DUT port under test
        # at the other end of that cable. REQUIRED: a bench without it aborts here.
        ({{ dut }}.portA, tb.ethA, _tb) = self._ck_bind_link(setup, {{ dut }}, 'tb')
        {%- endif %}
        {%- if links.cusfp %}
        # The COPPER-SFP link (a 1000BASE-T module in a cage), OPTIONAL: taken first so the
