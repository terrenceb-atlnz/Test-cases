# Note: Large raw source files (Zephyr XML + full extracts) are intentionally
# included in this repository because tools depend on them.
# They are tracked using Git LFS (see .gitattributes).

# The following large files use Git LFS:
#   Zephyr-Database-*.xml
#   data/zephyr_full/zephyr_cases.jsonl
#   data/zephyr_full/index.json

# Other potentially large but currently tracked data (testlink, all_test_suites) are also included.

# Other Zephyr export files (not the primary source)
zephyr-scale-tests-export*.xml

# Temporary, backup, and output files
backups/
*.bak
*.tmp
*.log

# IDE / editor
.idea/
.vscode/
*.swp
*.swo
*~

# Ask CK background-server runtime files (setup.sh)
.ck-server.pid
.ck-server.log

# Ask CK LLM observability: per-session request logs (full prompts/responses)
ask-ck/CK-main/CK_server/debug-log/

# Ask CK Local LLM credential (app-owned, set via Configure page) — never commit
ask-ck/CK-main/CK_server/secrets.local.json

# Ask CK SQLite data layer. ck.db is the PERMANENT single source of truth (built
# once from the provided data; NOT rebuildable — couriers retired). It and the
# bundled embedding model are versioned via Git LFS. Only the transient WAL/SHM
# side-files are ignored.
ask-ck/var/*
!ask-ck/var/ck.db
!ask-ck/var/models/
ask-ck/var/ck.db-wal
ask-ck/var/ck.db-shm

# Playwright E2E (ask-ck/ck-facelift/PLAN-playwright-e2e.md)
node_modules/
e2e/.report/
e2e/.artifacts/
test-results/
