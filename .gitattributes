# Git LFS tracking for large raw source data that the tools depend on.
# Paths are repo-root-relative and reflect the 2026-07-13 restructure
# (data now lives under ask-ck/objective-drafting/).
Zephyr-Database-*.xml filter=lfs diff=lfs merge=lfs -text
ask-ck/objective-drafting/data/zephyr_full/zephyr_cases.jsonl filter=lfs diff=lfs merge=lfs -text
ask-ck/objective-drafting/data/zephyr_full/index.json filter=lfs diff=lfs merge=lfs -text
ask-ck/objective-drafting/data/suites/testlink_awp.json filter=lfs diff=lfs merge=lfs -text
# Literal script source + code chunks (build input for ck.db script-code search);
# a captured snapshot of testbox .py sources, same category as zephyr_cases.jsonl.
ask-ck/pytest-create/data/scripts_sources.jsonl filter=lfs diff=lfs merge=lfs -text
# ck.db is the PERMANENT single source of truth (built once, not rebuildable) +
# the bundled offline embedding model. Both versioned via LFS.
ask-ck/var/ck.db filter=lfs diff=lfs merge=lfs -text
ask-ck/var/models/** filter=lfs diff=lfs merge=lfs -text
# Optional: track other large data files with LFS if they grow
# ask-ck/objective-drafting/data/suites/all_test_suites.json filter=lfs diff=lfs merge=lfs -text
# ask-ck/objective-drafting/data/suites/test_id_description.json filter=lfs diff=lfs merge=lfs -text
# Text files that should not be converted
*.md text
*.py text
*.json text
*.html text
*.css text
*.txt text
# Binary / generated that should stay as-is
*.xml binary
*.png binary
*.csv text
