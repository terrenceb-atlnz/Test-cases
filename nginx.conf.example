# Example nginx config for the drafting tool server
# Place in /etc/nginx/sites-available/ or similar, then symlink and reload.

server {
    listen 80;
    server_name _;  # or your local hostname / IP

    location /drafting-tool/ {
        proxy_pass http://127.0.0.1:8000/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }

    # Optionally serve static if separate
}

# Run the backend with:
# uvicorn server.main:app --host 127.0.0.1 --port 8000
# Then access http://your-local-ip/drafting-tool/